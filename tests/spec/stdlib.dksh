print(split("a,b,c", ","), join(["x", 1, true], "-"), trim("  pad \n"))
print(startsWith("hello", "he"), endsWith("hello", "lo"), contains("hello", "ell"))
print(replace("a.b.c", ".", "/"), upper("MiXed"), lower("MiXed"))
print(baseName("/usr/lib/libc.so"), dirName("/usr/lib/libc.so"), baseName("/"), dirName("file"))
var d = $(mktemp -d)
writeFile("${d}/f.txt", "line1\n")
appendFile("${d}/f.txt", "line2\n")
print(readFile("${d}/f.txt") == "line1\nline2\n", exists("${d}/f.txt"), isFile("${d}/f.txt"), isDir(d), exists("${d}/nope"))
print(len(glob("${d}/*")))
rm -rf $d
print(type(pid()), len(hostName()) > 0, cwd() == $(pwd))
print(shortPath("/etc/passwd"))
print(date("%Y-%m-%d %H:%M:%S %Z") != "")
print(split("héé", ""))
exit(0)
