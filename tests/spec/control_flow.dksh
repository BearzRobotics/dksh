var n = 7
if (n < 5) { print("small") } else if (n < 10) { print("medium") } else { print("large") }
var i = 0
while (i < 10) {
    i += 1
    if (i == 3) { continue }
    if (i == 6) { break }
    printf("%d ", i)
}
print()
for (var j = 0; j < 3; j++) { printf("j%d ", j) }
print()
for (item in ["a", "b", "c"]) { printf("%s", item) }
print()
for (var k = 10; k > 0; k -= 4) { printf("%d ", k) }
print()
if true { print("command condition") }
if false { print("no") } else { print("else branch") }
if grep -q root /etc/passwd { print("grep cond") }
while false { print("never") }
