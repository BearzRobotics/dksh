try { error("boom") } catch (e) { print("caught:", e.message, e.line, e.column, e.file, e.status) }
try { false } catch (e) { print("status:", e.status, e.message) }
try { sh -c 'exit 3' } catch (e) { print("status:", e.status) }
try {
    try { error("inner") } catch (e) { error("outer from ${e.message}") }
} catch (e) { print(e.message) }
try { print(1 / 0) } catch (e) { print(e.message) }
