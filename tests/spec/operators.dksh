print(1 + 2 * 3, (1 + 2) * 3, 10 - 4 - 3, 2 * 3 % 4)
print(1 < 2, 2 <= 2, "a" < "b", 3 > 5, 2.5 >= 2)
print(true && false || true, !true, !(1 == 2))
print(1 < 2 ? "yes" : "no", false ? 1 : true ? 2 : 3)
print("a" + "b" + "c", [1] + [2] + [3])
print(1 + 2.5, 2 * 0.5, 10 / 4, 10 / 4.0)
print(-3, - -3, -(2 + 3))
var x = 5
x += 2; x -= 1; x *= 3; x /= 2
print(x)
x++
x--
x++
print(x)
